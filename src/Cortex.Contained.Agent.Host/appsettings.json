{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MemoryMcp": {
    "DataDirectory": "/app/state/memory",
    "DuplicateThreshold": 0.90,
    "Ollama": {
      "Endpoint": "http://ollama:11434",
      "Model": "qwen3-embedding:0.6b",
      "Dimensions": 1024,
      "NumCtx": 4096
    },
    "Search": {
      "DefaultMode": "Dense",
      "KeywordVariant": "Plain",
      "Fusion": "Rrf",
      "RrfK": 60,
      "Candidates": 50,
      "UseQueryInstruction": false
    }
  },
  "MemoryCompaction": {
    "Enabled": true,
    "PreferredTimeOfDay": "03:00",
    "IntervalHours": 24,
    "SimilarityThreshold": 0.7
  },
  "History": {
    "Enabled": false,
    "TimeZone": "Europe/Copenhagen",
    "IdleGapMinutes": 30,
    "MaxSegmentWords": 1500,
    "DfCapRatio": 0.2,
    "SearchTokenCap": 1500,
    "UnindexedTailMax": 2000,
    "SmokeArtifactsDirectory": "/app/state/eval/smoke",
    "EvalArtifactsDirectory": "/app/state/eval/hybrid",
    "KeywordVariant": "Plain",
    "Dense": {
      "Enabled": false,
      "ChunkWords": 256,
      "ChunkOverlapWords": 32,
      "MaxChunkChars": 3000,
      "UseQueryInstruction": true,
      "AllowedEndpointHosts": "embeddings",
      "OpenSegmentDebounceMessages": 10,
      "OpenSegmentDebounceSeconds": 120,
      "QueryTimeoutMs": 3000
    },
    "Ranking": {
      "Fusion": "Rrf",
      "RrfK": 60,
      "ExactIntentKeywordBoost": 2.0,
      "CollapseWorkerDuplicates": true,
      "RecencyWeight": 0
    }
  }
}
